# PhotoAI backend ortam degiskenleri sablonu.
# Kopyalayip .env yapin ve gercek degerlerinizi girin:
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env

# ------------------------------------------------------------------
# VERITABANI
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/photoai_db

# ------------------------------------------------------------------
# VLM (Gorsel Dil Modeli) - icerik analizi
# ------------------------------------------------------------------
# AI_PROVIDER=lm_studio -> yerel, VLM_BASE_URL ".../v1" ile bitmeli.
# AI_PROVIDER=bedrock   -> AWS Bedrock; VLM_BASE_URL/VLM_MODEL kullanilmaz,
#                          onun yerine asagidaki AWS_* ayarlari gecerli olur.
AI_PROVIDER=lm_studio
VLM_BASE_URL=http://localhost:1234/v1
VLM_MODEL=qwen/qwen2.5-vl-7b

# AI_PROVIDER=bedrock iken:
# AWS kimlik bilgileri BURADA DEGIL - standart AWS zinciriyle saglanir
# (ortam degiskenleri AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, ~/.aws/credentials,
# ya da IAM rolu).
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ------------------------------------------------------------------
# KIMLIK DOGRULAMA (JWT) - coklu kullanicili paylasilan kurumsal arsiv
# ------------------------------------------------------------------
# JWT_SECRET ZORUNLU, varsayilani YOK - production'da uzun/rastgele bir
# deger kullanin (ornek uretme: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Acik self-register yok; ilk admin hesabi scripts/create_admin.py ile
# olusturulur, sonrasi POST /users (admin-only) ile.
JWT_SECRET=your_long_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------
# YUZ TANIMA MODELLERI (varsayilanlar coğu kurulum icin yeterli)
# ------------------------------------------------------------------
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
AURAFACE_MODEL_DIR=models/auraface

# ------------------------------------------------------------------
# QDRANT (vektor veritabani)
# ------------------------------------------------------------------
# "localhost" DEGIL "127.0.0.1" kullanin - Windows'ta IPv6 cozumlemesi
# yuzunden ~250 kat yavaslamaya yol acabiliyor (bkz. Bolum 12.1, Mevcut
# Durum Dokumani).
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ------------------------------------------------------------------
# HIBRIT KIMLIK ATAMA (opsiyonel, deneysel katman)
# ------------------------------------------------------------------
# Varsayilan: KAPALI + GOLGE MOD. Gercek atamanin hibrit karara gore
# yapilmasi icin IKISI BIRDEN gerekir:
#   HYBRID_ASSIGNMENT_ENABLED=true VE HYBRID_SHADOW_MODE=false
HYBRID_ASSIGNMENT_ENABLED=false
HYBRID_SHADOW_MODE=true
HYBRID_CONFIDENCE_THRESHOLD=0.55
HYBRID_GAP_THRESHOLD=0.05
HYBRID_TOP_CANDIDATES=5
HYBRID_QUALITY_WEIGHTING_ENABLED=true

# ------------------------------------------------------------------
# YEDEKLEME (scripts/backup_system.py)
# ------------------------------------------------------------------
# Bos birakilirsa varsayilan (Masaustu/PhotoAI-Backups) kullanilir.
# PHOTOAI_BACKUP_ROOT=C:\Users\erdem\Google Drive\PhotoAI-Backups
